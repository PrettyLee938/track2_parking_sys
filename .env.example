# Copy to .env (repo root) and adjust. Every value is optional; defaults and
# descriptions live in server/src/config.ts. Invalid values stop the server at startup.

# --- simulator connection ---
GPA_SIM_BASE_URL=http://127.0.0.1:9898/api/v1
GPA_SIM_USER=admin
GPA_SIM_PASSWORD=admin

# --- this server ---
GPA_APP_PORT=8000
# fatal | error | warn | info | debug | trace
GPA_LOG_LEVEL=info

# --- dashboard accounts ---
# First start only: the admin account created when there are no users yet.
# Without a password, one is generated and printed once in the server log.
GPA_ADMIN_USERNAME=admin
GPA_ADMIN_PASSWORD=admin
GPA_SESSION_TTL_H=12
GPA_LOGIN_MAX_FAILURES=5
GPA_LOGIN_LOCKOUT_S=60

# --- behaviour ---
GPA_CONTROLLER_ENABLED=true
# Level 1 sends Signature=null; Level 2 signs its webhooks. Turn this on for Level 2.
GPA_REQUIRE_SIGNATURE=false
# Safety net while turning the line above on: this many failing events are processed
# anyway (and flagged) until the first signature verifies, so a wrong guess about the
# signing scheme cannot silently drop a whole run. 0 = strict from the first event.
GPA_SIGNATURE_GRACE_N=50
# When the active scheme fails, try the other known ones and adopt any that matches.
GPA_SIGNATURE_AUTODETECT=true
# Only if the simulator signs with a shared secret. Without one the digest proves
# integrity, not origin.
# GPA_WEBHOOK_SECRET=

# --- site layout & game speed ---
GPA_TOPOLOGY_DIR=topology
# The simulator's settings folder. Game speed is read from its settings.json, and gate
# pairings are derived from its lvl*.json when no topology/*.json matches the level.
# GPA_SIM_LEVELS_DIR=C:/path/to/ParkingSimulator-win-x64/settings
# Fixed game speed override (normally leave unset: read from settings.json, then learned
# from completed stays and gate timing, so Shift+PgUp changes are followed within seconds).
# GPA_GAME_SPEED=1.7
# No webhook for this many real seconds = game paused: the game clock stops meanwhile.
GPA_PAUSE_AFTER_SILENCE_S=20

# --- spot allocation: lane_zone_first_free | any_zone_first_free (see server/src/allocation.ts) ---
GPA_ALLOCATION_STRATEGY=lane_zone_first_free

# --- billing: planned | round | ceil ---
GPA_BILLING_ROUNDING=planned
GPA_PRICE_PER_MINUTE=1
GPA_ELECTRIC_MULTIPLIER=2
GPA_RECHARGE_ON_WRONG_AMOUNT=true

# --- simulator timing, in GAME seconds (scaled by game speed automatically) ---
GPA_EXIT_CHARGE_DELAY_GAME_S=1.5
GPA_GATE_CLOSE_DELAY_GAME_S=1.5
GPA_GATE_CONFIRM_GAME_S=3
# The simulator silently drops some gotos: re-send if the car has not moved after this long.
GPA_GOTO_CONFIRM_GAME_S=4
GPA_MAX_GOTO_RESENDS=5
GPA_ENTRY_PATIENCE_GAME_S=290
GPA_RESYNC_AFTER_SILENCE_GAME_S=30

# --- lost webhooks: retire car records whose closing event never arrived (GAME seconds) ---
GPA_RELEASE_TIMEOUT_GAME_S=30
GPA_PARKED_OVERSTAY_GAME_S=300
GPA_STALE_CAR_GAME_S=600

# --- storage ---
GPA_DATA_DIR=data

# --- components: wear, maintenance, air, light (Level 2) ---
# Usage cycles since a component's last repair before preventive maintenance is due.
# 0 disables that kind. These are conservative guesses until a real Level 2 run shows
# how fast components actually wear - watch component_broken events and tighten them.
GPA_MAINT_GATE_CYCLES=400
GPA_MAINT_SPOT_CYCLES=120
GPA_MAINT_DEVICE_CYCLES=200
GPA_MAINT_DEVICE_RUNTIME_GAME_S=7200
# Service every component this long after its last repair, whatever its usage. REAL
# seconds. 0 = off, because the simulator breaks things by usage, not age. Set it small
# (e.g. 60) to watch the whole maintenance loop run during a test.
GPA_MAINT_MAX_AGE_S=0
GPA_PREVENTIVE_MAINTENANCE=true
# Repair a component as soon as the simulator reports it broken. A broken entry gate stops
# that entrance entirely, so this is not subject to the per-zone budget below.
GPA_AUTO_REPAIR_BROKEN=true
# Re-send a repair the simulator dropped, this often, while still reported broken.
GPA_REPAIR_RETRY_GAME_S=30
# Components WE take out of service at once per zone (broken ones do not count).
GPA_MAINT_MAX_CONCURRENT_PER_ZONE=1
GPA_MAINT_INTERVAL_GAME_S=60

# Ventilate at or above ON, stop below OFF. The gap stops the fans chattering, and
# every flip is a usage cycle.
GPA_CO_ON_PPM=50
GPA_CO_OFF_PPM=30
GPA_CO_TRUST_DANGER_WORD=true
# The simulator only SENDS carbon_monoxide_event at Mid (~50) and above, so below that a
# webhook-only system is blind and a threshold under Mid can never fire. Polling
# GET /list-zones this often (GAME seconds) reads CO directly and fills that gap; it also
# recovers if a CO webhook is lost. 0 = off. Each list-* call has a simulated cost.
GPA_ZONE_POLL_GAME_S=10

# Lights off during simulator daytime, read from the ServerDateTime on events.
GPA_LIGHTS_FOLLOW_DAYLIGHT=true
GPA_DAYLIGHT_FROM_HOUR=7
GPA_DAYLIGHT_TO_HOUR=19
