# Copy to .env (repo root) and adjust. Every value is optional; defaults and
# descriptions live in server/src/config.ts. Invalid values stop the server at startup.

# --- simulator connection ---
GPA_SIM_BASE_URL=http://127.0.0.1:9898/api/v1
GPA_SIM_USER=admin
GPA_SIM_PASSWORD=admin

# --- this server ---
GPA_APP_PORT=8000
# fatal | error | warn | info | debug | trace
GPA_LOG_LEVEL=info

# --- dashboard accounts ---
# First start only: the admin account created when there are no users yet.
# Without a password, one is generated and printed once in the server log.
GPA_ADMIN_USERNAME=admin
GPA_ADMIN_PASSWORD=admin
GPA_SESSION_TTL_H=12
GPA_LOGIN_MAX_FAILURES=5
GPA_LOGIN_LOCKOUT_S=60

# --- behaviour ---
GPA_CONTROLLER_ENABLED=true
# Level 2 requires signed deliveries; use level1 only when running the Level 1 simulator.
GPA_WEBHOOK_PROFILE=level2
# Extra hardening for Level 1 only; Level 2 requires signatures even if this is false.
GPA_REQUIRE_SIGNATURE=false
# The simulator uses a checksum without a shared secret; local-only ingress is the safe default.
GPA_WEBHOOK_LOOPBACK_ONLY=true

# --- site layout & game speed ---
GPA_TOPOLOGY_DIR=topology
# The simulator's settings folder. Game speed is read from its settings.json, and gate
# pairings are derived from its lvl*.json when no topology/*.json matches the level.
# GPA_SIM_LEVELS_DIR=C:/path/to/ParkingSimulator-win-x64/settings
# Fixed game speed override (normally leave unset: read from settings.json, then learned
# from completed stays and gate timing, so Shift+PgUp changes are followed within seconds).
# GPA_GAME_SPEED=1.7
# Calibrate in an isolated Level 2 run before enabling CO recovery checks.
# This is simulator game-seconds; unset means recovery verification stays unavailable.
# GPA_CO_MINIMUM_VENTILATION_GAME_S=
# No webhook for this many real seconds = game paused: the game clock stops meanwhile.
GPA_PAUSE_AFTER_SILENCE_S=20

# --- spot allocation: lane_zone_first_free | any_zone_first_free (see server/src/allocation.ts) ---
GPA_ALLOCATION_STRATEGY=lane_zone_first_free

# --- billing: planned | round | ceil ---
GPA_BILLING_ROUNDING=planned
GPA_PRICE_PER_MINUTE=1
GPA_ELECTRIC_MULTIPLIER=2
GPA_RECHARGE_ON_WRONG_AMOUNT=true

# --- simulator timing, in GAME seconds (scaled by game speed automatically) ---
GPA_EXIT_CHARGE_DELAY_GAME_S=1.5
GPA_GATE_CLOSE_DELAY_GAME_S=1.5
GPA_GATE_CONFIRM_GAME_S=3
# The simulator silently drops some gotos: re-send if the car has not moved after this long.
GPA_GOTO_CONFIRM_GAME_S=4
GPA_MAX_GOTO_RESENDS=5
GPA_ENTRY_PATIENCE_GAME_S=290
GPA_RESYNC_AFTER_SILENCE_GAME_S=30

# --- lost webhooks: retire car records whose closing event never arrived (GAME seconds) ---
GPA_RELEASE_TIMEOUT_GAME_S=30
GPA_PARKED_OVERSTAY_GAME_S=300
GPA_STALE_CAR_GAME_S=600

# --- storage ---
GPA_DATA_DIR=data
