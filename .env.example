# Copy to .env and adjust. Every value is optional; defaults live in app/config.py.

# --- simulator connection ---
GPA_SIM_BASE_URL=http://127.0.0.1:9898/api/v1
GPA_SIM_USER=admin
GPA_SIM_PASSWORD=admin

# --- this server ---
GPA_APP_PORT=8000
GPA_LOG_LEVEL=INFO

# --- behaviour ---
GPA_CONTROLLER_ENABLED=true
GPA_REQUIRE_SIGNATURE=false

# --- site layout ---
GPA_TOPOLOGY_DIR=topology
# Fallback when no topology/*.json matches the running level:
# GPA_SIM_LEVELS_DIR=C:/path/to/ParkingSimulator-win-x64/settings

# --- spot allocation: lane_zone_first_free | any_zone_first_free (see app/allocation.py) ---
GPA_ALLOCATION_STRATEGY=lane_zone_first_free

# --- billing: round | ceil | planned ---
GPA_BILLING_ROUNDING=round
GPA_PRICE_PER_MINUTE=1
GPA_ELECTRIC_MULTIPLIER=2

# --- timing (seconds) ---
GPA_EXIT_CHARGE_DELAY_S=1.5
GPA_GATE_CLOSE_DELAY_S=3
GPA_ENTRY_PATIENCE_S=290
