# Copy to .env (repo root) and adjust. Every value is optional; defaults and
# descriptions live in server/src/config.ts. Invalid values stop the server at startup.

# --- simulator connection ---
GPA_SIM_BASE_URL=http://127.0.0.1:9898/api/v1
GPA_SIM_USER=admin
GPA_SIM_PASSWORD=admin

# --- this server ---
GPA_APP_PORT=8000
# fatal | error | warn | info | debug | trace
GPA_LOG_LEVEL=info

# --- dashboard accounts ---
# First start only: the admin account created when there are no users yet.
# Without a password, one is generated and printed once in the server log.
GPA_ADMIN_USERNAME=admin
GPA_ADMIN_PASSWORD=admin
GPA_SESSION_TTL_H=12
GPA_LOGIN_MAX_FAILURES=5
GPA_LOGIN_LOCKOUT_S=60

# --- behaviour ---
GPA_CONTROLLER_ENABLED=true
# strict = act only on correctly signed webhooks (Level 2+) | lenient = also unsigned (Level 1)
# | monitor = act on all, just record the signature status (checking a new level)
GPA_SIGNATURE_MODE=lenient

# --- site layout & game speed ---
GPA_TOPOLOGY_DIR=topology
# The simulator's settings folder. Game speed is read from its settings.json, and gate
# pairings are derived from its lvl*.json when no topology/*.json matches the level.
# GPA_SIM_LEVELS_DIR=C:/path/to/ParkingSimulator-win-x64/settings
# Fixed game speed override (normally leave unset: read from settings.json, then learned
# from completed stays and gate timing, so Shift+PgUp changes are followed within seconds).
# GPA_GAME_SPEED=1.7
# No webhook for this many real seconds = game paused: the game clock stops meanwhile.
GPA_PAUSE_AFTER_SILENCE_S=20

# --- spot allocation: lane_zone_first_free | lane_zone_then_any | zone_balanced | any_zone_first_free (server/src/allocation.ts) ---
# zone_balanced (Level 2): spread cars over zones by load, exit-gate health/wear and spot wear.
GPA_ALLOCATION_STRATEGY=lane_zone_first_free
GPA_ZONE_EXIT_DOWN_COST=1
GPA_ZONE_EXIT_WEAR_COST=0.3
# Extra cost per gate further down the road on the way to a zone (ENTRY1 -> ZONE2 also opens gate3).
GPA_ZONE_ROUTE_GATE_COST=0.15
# A car on its way down the road holds the gates it still has to pass for at most this long.
GPA_TRANSIT_MAX_GAME_S=60

# --- billing: planned | round | ceil ---
GPA_BILLING_ROUNDING=planned
GPA_PRICE_PER_MINUTE=1
GPA_ELECTRIC_MULTIPLIER=2
GPA_RECHARGE_ON_WRONG_AMOUNT=true

# --- simulator timing, in GAME seconds (scaled by game speed automatically) ---
GPA_EXIT_CHARGE_DELAY_GAME_S=1.5
# Each "should be charged at the exit" penalty adds 0.5 game-s to that exit's delay, up to this much.
GPA_EXIT_CHARGE_DELAY_MAX_EXTRA_GAME_S=3
GPA_GATE_CLOSE_DELAY_GAME_S=1.5
# Entry gates stay open across a stream of cars: every closing costs one of a gate's ~10 cycles.
GPA_ENTRY_GATE_CLOSE_DELAY_GAME_S=10
GPA_GATE_CONFIRM_GAME_S=3
# The simulator silently drops some gotos: re-send if the car has not moved after this long.
GPA_GOTO_CONFIRM_GAME_S=4
GPA_MAX_GOTO_RESENDS=5
GPA_ENTRY_PATIENCE_GAME_S=290
GPA_RESYNC_AFTER_SILENCE_GAME_S=30

# --- lost webhooks: retire car records whose closing event never arrived (GAME seconds) ---
GPA_RELEASE_TIMEOUT_GAME_S=30
GPA_PARKED_OVERSTAY_GAME_S=300
# Overdue parked cars are only written off once list-parking-spots shows their spot empty (checked at most this often).
GPA_PARKED_CHECK_GAME_S=60
GPA_STALE_CAR_GAME_S=600

# --- component health (Level 2): repair broken gates/spots/fans as soon as nothing uses them ---
GPA_AUTO_REPAIR=true
GPA_REPAIR_RETRY_GAME_S=10
# Preventive: repair when one more use would break it, or at this share of the limit when idle.
# Limits are learned from breakdowns (gates: 10 openings); 0 = learn.
GPA_PREVENTIVE_MAINTENANCE=true
GPA_PREVENTIVE_IDLE_RATIO=0.8
# Spots are only repaired early while their zone keeps more free spots than this.
GPA_SPOT_REPAIR_MIN_FREE=3
# A worn-out gate waits for its repair; if none starts within this long, it is used anyway.
GPA_WORN_WAIT_MAX_GAME_S=20
GPA_GATE_CYCLE_LIMIT=0
GPA_SPOT_USE_LIMIT=0
GPA_FAN_HOUR_LIMIT=0
# Exhaust fans: on while a zone's CO >= ON level, off below OFF level (spec: off below 50). The level is
# read with list-zones every POLL game-s while there is traffic or a fan runs (no CO webhooks arrive).
GPA_FAN_CONTROL=true
GPA_CO_FAN_ON_LEVEL=50
GPA_CO_FAN_OFF_LEVEL=50
GPA_CO_POLL_GAME_S=15
# Payments with a bad signature are fakes: never released for; ask the car to pay once more.
GPA_RECHARGE_AFTER_FAKE_PAYMENT=true

# --- storage ---
GPA_DATA_DIR=data
