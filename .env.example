APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_PATH=./data/parking.db

SIMULATOR_BASE_URL=http://127.0.0.1:9898
SIMULATOR_USERNAME=admin
SIMULATOR_PASSWORD=admin

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator

# The current simulator build emits null signatures for ordinary car events.
# Keep this false until the simulator provider fixes those payloads.
REQUIRE_WEBHOOK_SIGNATURE=false

# Automatically guide arriving cars to free spots. Set to false for manual control.
AUTO_ASSIGN=true
# Barrier opened for one admitted car. Level 1 uses gateA.
ENTRY_GATE_NAME=gateA
# Milliseconds to let a barrier finish opening before sending the first car
# through it. Only the first car through a shut gate waits.
GATE_SETTLE_MS=2000

# Charge cars automatically once they reach an exit spot, which releases them.
AUTO_CHARGE=true

# Close the configured entry barrier during startup.
CLOSE_BARRIERS_ON_START=true
# Heartbeat that keeps the park moving when webhooks pause (0 disables).
DISPATCH_INTERVAL_MS=5000
# Retry gap while waiting for a level to be loaded in the simulator.
BOOTSTRAP_RETRY_MS=5000
# Release a reservation if the car never reaches its spot in time.
STALE_ASSIGNMENT_MS=120000
# Minimum gap between reconciliation re-syncs when the park looks stalled.
RECONCILE_INTERVAL_MS=60000

# Forget the previous run's cars when a level is loaded. Their reservations would
# otherwise block spots that nobody is parked in.
RESET_STATE_ON_START=true
# Turn cars away via an escape route once the park is full. Without this the entry
# spot overflows and the simulator gridlocks.
REJECT_WHEN_FULL=true
# Cars allowed to wait at the entrance before the surplus is turned away.
MAX_ENTRY_QUEUE=5

# Barrier opened only while a car is leaving; shut at all other times.
EXIT_GATE_NAME=gateB
# Treat a gate stuck in Closing as closed after this long. The simulator does not
# always deliver the confirming gate_action webhook.
GATE_CLOSE_TIMEOUT_MS=5000
# Real seconds the simulator takes per parking minute, measured at ~10 on Level 1.
# Used only when a car's declared duration is unknown.
SIMULATED_MINUTE_SECONDS=10

# How long to wait for the payment_made webhook before releasing a charged car.
# This build delivers it for only about a quarter of charges, so 0 (demand the
# webhook) will trap most cars at the exit.
PAYMENT_CONFIRM_TIMEOUT_MS=0

# Re-issue a charge when payment_made never arrives, so a car cannot sit on the
# exit spot forever and block it. Capped so a car is not billed endlessly.
RECHARGE_AFTER_MS=20000
MAX_RECHARGE_ATTEMPTS=2

# Also wipe stored events (including penalties) and the command audit at startup.
# Leave false to keep the history for diagnosing the previous run.
RESET_HISTORY_ON_START=false

# Wait this long after a car reaches the exit spot before charging it. Measured:
# a charge sent within ~0.25s of the arrival webhook is silently ignored and
# earns "Car should be charged at the exit"; after ~1.1s it is accepted.
CHARGE_DELAY_MS=1500

# Stop holding the exit gate open for a car that never actually leaves.
RELEASE_TIMEOUT_MS=30000
